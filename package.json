  "license": "MIT",
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "EXPO_NO_DEVTOOLS=1 expo start --dev-client",
    "android": "expo run:android",
    "android:dev": "APP_VARIANT=development expo run:android --variant debug",
    "android:preview": "APP_VARIANT=preview expo run:android --variant release",
    "ios": "expo run:ios",
    "ios:dev": "APP_VARIANT=development expo run:ios",
    "ios:preview": "APP_VARIANT=preview expo run:ios --configuration Release",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "i18n:sync": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/i18n-sync.mjs",
    "lint": "eslint . --ext .ts,.tsx",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "test": "jest",
    "test:release-note": "node --test scripts/build-release-note.test.mjs scripts/publish-release-note.test.mjs",
    "test:coverage": "jest --coverage --coverageReporters=json-summary --coverageReporters=text",
    "perf": "bash scripts/perf-suite.sh",
    "perf:pixel": "bash scripts/perf-suite-pixel.sh",
    "perf:pixel:quick": "SAMPLES=1 bash scripts/perf-suite-pixel.sh",
    "perf:pixel:long": "SAMPLES=5 bash scripts/perf-suite-pixel.sh",
    "postinstall": "patch-package && node scripts/fetch-nostr-sdk-swift.mjs"
  },
