+    /**
+     * Lightning Piggy patch: copy one shared stream into `cache/lp-share/` under
+     * a generated name (the sender's display name is never used for a path),
+     * stopping at LP_MAX_SHARED_BYTES. The extension comes from the provider's
+     * MIME type; the app re-checks the real type from the file's bytes.
+     */
+    fun copySharedFile(resolver: ContentResolver, uri: Uri, mimeType: String): String? {
+        val dir = File(context.cacheDir, LP_SHARE_DIR)
+        if (!dir.exists() && !dir.mkdirs()) return null
+        val ext = when (mimeType) {
+            "image/png" -> "png"
+            "image/gif" -> "gif"
+            "image/webp" -> "webp"
+            "image/heic", "image/heif" -> "heic"
+            else -> "jpg"
+        }
+        val target = File(dir, "share-${UUID.randomUUID()}.$ext")
+        return try {
+            val input = resolver.openInputStream(uri) ?: return null
+            input.use { inp ->
+                FileOutputStream(target).use { out ->
+                    val buffer = ByteArray(64 * 1024)
+                    var total = 0L
+                    while (true) {
+                        val read = inp.read(buffer)
+                        if (read < 0) break
+                        total += read
+                        if (total > LP_MAX_SHARED_BYTES) throw IOException("shared file too large")
+                        out.write(buffer, 0, read)
+                    }
+                }
+            }
+            target.path
+        } catch (e: Exception) {
+            target.delete()
+            null
+        }
+    }
